## /etc/audit/rules.d/atomic.rules
## Telemetry for the detection lab. Keys (-k) are what the SPL pivots on — keep them stable.

## Process execution
-a exit,always -F arch=b64 -S execve -k exec
-a exit,always -F arch=b32 -S execve -k exec

## Identity / credential files
## /etc/shadow gets a READ watch: legitimate reads are rare, so it's high-signal (T1003.008).
## /etc/passwd does not: it's read by every login, ls -l and id.
-w /etc/passwd -p wa -k identity
-w /etc/shadow -p rwa -k identity
-w /etc/group  -p wa -k identity
-w /etc/sudoers -p wa -k priv_esc
-w /etc/sudoers.d -p wa -k priv_esc

## Persistence
-w /etc/crontab -p wa -k persistence
-w /etc/cron.d -p wa -k persistence
-w /var/spool/cron -p wa -k persistence
-w /etc/systemd/system -p wa -k persistence
-w /root/.ssh -p wa -k ssh_keys

## Tooling
-w /usr/bin/curl -p x -k download
-w /usr/bin/wget -p x -k download
-w /usr/bin/nc -p x -k recon
-w /usr/bin/nmap -p x -k recon
